[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/vrsky/bin/windows/vrsky_native.dll"
windows.release.x86_64 = "res://addons/vrsky/bin/windows/vrsky_native.dll"
linux.debug.x86_64 = "res://addons/vrsky/bin/linux/libvrsky_native.so"
linux.release.x86_64 = "res://addons/vrsky/bin/linux/libvrsky_native.so"
android.debug.arm64 = "res://addons/vrsky/bin/android/arm64-v8a/libvrsky_native.so"
android.release.arm64 = "res://addons/vrsky/bin/android/arm64-v8a/libvrsky_native.so"
