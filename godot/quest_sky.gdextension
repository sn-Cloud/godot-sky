[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://godot/bin/quest_sky_native.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://godot/bin/quest_sky_native.windows.release.x86_64.dll"
linux.debug.x86_64 = "res://godot/bin/libquest_sky_native.linux.debug.x86_64.so"
linux.release.x86_64 = "res://godot/bin/libquest_sky_native.linux.release.x86_64.so"
android.debug.arm64 = "res://godot/bin/libquest_sky_native.android.debug.arm64.so"
android.release.arm64 = "res://godot/bin/libquest_sky_native.android.release.arm64.so"
